{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doppeldecker",
  "version": "0.1.124",
  "identifier": "com.doppeldecker.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "create": false,
        "title": "Doppeldecker",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCOUJBRjlGNUE2RkQ5RjgKUldUNDJXOWFuNitiTzU2WGhWeXlFdWh0anFXc1V3V3VZT2g0S2pNbmQrK09NMEtXUzhDeHAvSUgK",
      "endpoints": [
        "https://github.com/DanielMuellerIR/Doppeldecker/releases/latest/download/latest.json"
      ]
    }
  }
}
